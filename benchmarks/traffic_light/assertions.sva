// Assertions for the traffic light. out[5]=ns_g out[4]=ns_y out[3]=ns_r
// out[2]=ew_g out[1]=ew_y out[0]=ew_r; in[2]=emergency in[1]=car_ew in[0]=car_ns.
t1_emerg_red:   assert property (@(posedge clk) $rose(in[2]) |-> ##[0:1] $rose(out[3]));
t2_ns_to_ew:    assert property (@(posedge clk) $fell(out[5]) |-> ##[1:3] $rose(out[2]));
// Cannot fail: north-south yellow always lasts exactly one cycle.
t3_ns_yellow:   assert property (@(posedge clk) $rose(out[4]) |=> $fell(out[4]));
t4_ew_green:    assert property (@(posedge clk) $rose(out[2]) |-> ##[1:2] $fell(out[2]));
t5_ns_request:  assert property (@(posedge clk) $rose(in[0]) |-> ##[2:4] $rose(out[5]));
// Cannot fail: ns_r is held high for the whole east-west phase.
t6_ew_start:    assert property (@(posedge clk) $fell(out[0]) |-> ##[0:2] $stable(out[3]));
t7_ew_yellow:   assert property (@(posedge clk) $rose(out[1]) |-> ##1 $rose(out[5]));
t8_ew_request:  assert property (@(posedge clk) $rose(in[1]) |-> ##[1:4] $rose(out[2]));
// Dominated by t8_ew_request.
t9_ew_request2: assert property (@(posedge clk) $rose(in[1]) |-> ##[1:3] $rose(out[2]));
t10_recover:    assert property (@(posedge clk) $fell(in[2]) |-> ##[1:2] $rose(out[5]));
